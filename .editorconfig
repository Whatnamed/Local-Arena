# Minimal editor conventions matching what the tree already uses. No formatter is wired up in this
# repository, so this only guides editors; do not run a mass reformat because of it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,cs,ps1,psm1}]
indent_style = space
indent_size = 4

[*.{ts,tsx,js,mjs,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.toml]
indent_style = space
indent_size = 4
